  <diagram id="eduhub-ch01-bw-class-diagram" name="EduHub Ch01 Class Diagram">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= 1. CLUB (Top Center) ================= -->
        <mxCell id="c_club" value="&lt;b&gt;Club&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color: #000000;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 4px; font-family: Consolas, monospace; font-size: 11px;&quot;&gt;- _members : List&amp;lt;Member&amp;gt;&lt;br&gt;+ Id : Guid { get; private set; }&lt;br&gt;+ Name : string { get; private set; }&lt;br&gt;+ Description : string { get; private set; }&lt;br&gt;+ CreatedAt : DateTime { get; private set; }&lt;br&gt;+ Members : IReadOnlyList&amp;lt;Member&amp;gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color: #000000;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 4px; font-family: Consolas, monospace; font-size: 11px;&quot;&gt;- Club(id, name, desc, createdAt)&lt;br&gt;&lt;b&gt;+ Create(name, desc)$ : Club&lt;/b&gt;&lt;br&gt;+ AddMember(member) : void&lt;br&gt;+ MemberCount() : int&lt;br&gt;+ HasMember(memberId) : bool&lt;br&gt;+ ToString() : string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="320" height="250" as="geometry" />
        </mxCell>

        <!-- ================= 2. EVENT (Middle Left) ================= -->
